{
  "expo": {
    "name": "Fare",
    "slug": "Budgetting",
    "version": "0.2.1.1",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "fare",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#0A1330",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "CFBundleDocumentTypes": [
          {
            "CFBundleTypeName": "Comma-separated values",
            "CFBundleTypeRole": "Viewer",
            "LSHandlerRank": "Alternate",
            "LSItemContentTypes": ["public.comma-separated-values-text"]
          }
        ]
      }
    },
    "android": {
      "package": "com.kafloosi.fare",
      "versionCode": 4,
      "adaptiveIcon": {
        "backgroundColor": "#0A1330",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": true,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": false,
          "data": [
            {
              "scheme": "fare"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        },
        {
          "action": "VIEW",
          "category": ["DEFAULT", "BROWSABLE"],
          "data": [
            { "mimeType": "text/csv" },
            { "mimeType": "text/comma-separated-values" },
            { "mimeType": "application/csv" }
          ]
        }
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0A1330",
          "dark": {
            "backgroundColor": "#0A1330"
          },
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 128
        }
      ],
      "expo-sqlite",
      "expo-sharing",
      [
        "expo-notifications",
        {
          "color": "#E7002A"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Fare attaches a photo of a receipt to an entry. Photos stay on this phone.",
          "cameraPermission": "Fare uses the camera to photograph a receipt. Photos stay on this phone."
        }
      ],
      "./plugins/with-quick-add-shortcut"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
